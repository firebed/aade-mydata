{
  "name": "firebed/aade-mydata",
  "type": "package",
  "description": "Implementation of requests for AADE myDATA.",
  "keywords": [
    "myDATA",
    "AADE",
    "ΑΑΔΕ"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Okan Giritli",
      "email": "okan.giritli@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-dom": "*",
    "ext-libxml": "*",
    "guzzlehttp/guzzle": "^7.8 || ^8.0",
    "psr/log": "^2.0 || ^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.21",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5 || ^12.0",
    "roave/security-advisories": "dev-latest",
    "symfony/var-dumper": "^7.0"
  },
  "suggest": {
    "phpunit/phpunit": "Required by the assertions of MyData::fake() (Testing\\FakeGateway)"
  },
  "autoload": {
    "psr-4": {
      "Firebed\\AadeMyData\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=1G",
    "lint": "pint --test",
    "fix": "pint"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
